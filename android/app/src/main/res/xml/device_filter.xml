<!--
    Chips de conversor serial RS232-USB mais comuns em cabos usados por
    balanças comerciais (ver escopo, item 10 — "balança via cabo").
    Usado pelo plugin usb_serial para detectar o adaptador conectado via
    OTG e, opcionalmente, abrir o app automaticamente ao conectar.
-->
<resources>
    <!-- 0x0403 / 0x6001: FTDI FT232 -->
    <usb-device vendor-id="1027" product-id="24577" />
    <!-- 0x0403 / 0x6015: FTDI FT231X -->
    <usb-device vendor-id="1027" product-id="24597" />
    <!-- 0x10C4 / 0xEA60: Silicon Labs CP2102/CP2109 UART Bridge -->
    <usb-device vendor-id="4292" product-id="60000" />
    <!-- 0x067B / 0x2303: Prolific PL2303 -->
    <usb-device vendor-id="1659" product-id="8963" />
    <!-- 0x1A86 / 0x7523: QinHeng CH340/CH341 -->
    <usb-device vendor-id="6790" product-id="29987" />
</resources>
